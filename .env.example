# SchoolApp credentials (recommended via env, not CLI args)
SCHOOLAPP_EMAIL=
SCHOOLAPP_PASSWORD=

# SMTP settings for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Telegram notifications (create bot with @BotFather, get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API key for the mobile app backend (any random string)
API_KEY=
